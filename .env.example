# ============================================================
#  AI Translator Website — Environment Variables TEMPLATE
#
#  INSTRUCTIONS:
#    1. Copy this file:  cp .env.example .env
#    2. Fill in your actual values in .env
#    3. NEVER commit the .env file (it is in .gitignore)
# ============================================================

# Google Gemini API key
# Get one free at: https://aistudio.google.com/app/apikey
# The key starts with "AIza..." — do NOT use an OAuth token.
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL database URL (e.g. from Supabase)
DATABASE_URL=postgresql://user:password@your_supabase_host:5432/postgres

# Server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
